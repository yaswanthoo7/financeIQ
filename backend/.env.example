# InvoiceIQ Backend Environment Variables
# Copy this file to .env and fill in the values

# App
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://invoiceiq:invoiceiq@localhost:5432/invoiceiq
DATABASE_URL_SYNC=postgresql+psycopg2://invoiceiq:invoiceiq@localhost:5432/invoiceiq

# Gemini API Key (required)
# Get yours free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key
GEMINI_MODEL=gemini-flash-latest

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# Extraction
CONFIDENCE_THRESHOLD=0.7
MAX_RETRIES=3
